          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/Auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"itstaff@itsupport.local\",\n  \"password\": \"123456\"\n}" }
          }
        },
        {
          "name": "Register (public)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/Auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Nguoi dung test\",\n  \"email\": \"newuser-{{$randomInt}}@itsupport.local\",\n  \"password\": \"Test@12345\",\n  \"confirmPassword\": \"Test@12345\"\n}" }
          }
        },
        {
          "name": "Forgot Password",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.isSuccess && json.data.resetToken) pm.collectionVariables.set('reset_token', json.data.resetToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/Auth/forgot-password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"employee@itsupport.local\"\n}" }
          }
        },
        {
          "name": "Reset Password (dung reset_token o tren)",
          "request": {
            "description": "Backend bat buoc mat khau moi phai KHAC mat khau hien tai. Chi chay sach lan dau tren DB moi seed (mat khau dang la Employee@123); neu chay lai lan 2 phai sua currentPassword/newPassword cho khop trang thai hien tai.",
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/Auth/reset-password",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"employee@itsupport.local\",\n  \"resetToken\": \"{{reset_token}}\",\n  \"newPassword\": \"Employee@123Reset\",\n  \"confirmNewPassword\": \"Employee@123Reset\"\n}" }
          }
        },
        {
          "name": "Change Password (dang nhap)",
          "request": {
            "description": "currentPassword phai khop mat khau vua duoc Reset Password o tren dat (Employee@123Reset).",
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employee_token}}" }
            ],
            "url": "{{base_url}}/Auth/change-password",
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Employee@123Reset\",\n  \"newPassword\": \"Employee@123\",\n  \"confirmNewPassword\": \"Employee@123\"\n}" }
          }
        }
      ]
    },
    {
