{
  "info": {
    "name": "IT Support Request Management System - API",
    "description": "Bo test API day du, khop dung backend thuc te (backend/ITsupport), khong phai file docs/api-spec.yaml cu (da lech). Chay theo thu tu tu tren xuong (Postman Collection Runner) de di het 1 vong doi ticket. Sau khi login, token duoc tu dong luu vao bien cua collection (admin_token/employee_token/coordinator_token/leader_token/itstaff_token) - cac request khac tu dung lai, khong can copy tay.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5219/api" },
    { "key": "admin_token", "value": "" },
    { "key": "employee_token", "value": "" },
    { "key": "coordinator_token", "value": "" },
    { "key": "leader_token", "value": "" },
    { "key": "itstaff_token", "value": "" },
    { "key": "request_id", "value": "1" },
    { "key": "new_user_id", "value": "" },
    { "key": "department_id", "value": "1" },
    { "key": "new_department_id", "value": "" },
    { "key": "priority_id", "value": "1" },
    { "key": "category_id", "value": "1" },
    { "key": "itgroup_id", "value": "1" },
    { "key": "role_id", "value": "2" },
    { "key": "comment_id", "value": "" },
    { "key": "attachment_id", "value": "" },
    { "key": "reset_token", "value": "" }
  ],
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Login - Admin",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('login ok', () => pm.expect(json.isSuccess).to.be.true);",
            "if (json.isSuccess) pm.collectionVariables.set('admin_token', json.data.accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/Auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@itsupport.local\",\n  \"password\": \"Admin@123\"\n}" }
          }
        },
        {
          "name": "Login - Employee",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.isSuccess) pm.collectionVariables.set('employee_token', json.data.accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/Auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"employee@itsupport.local\",\n  \"password\": \"Employee@123\"\n}" }
