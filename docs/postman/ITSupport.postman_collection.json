            "body": { "mode": "raw", "raw": "{\n  \"email\": \"coordinator@itsupport.local\",\n  \"password\": \"123456\"\n}" }
          }
        },
        {
          "name": "Login - Leader",
          "event": [{ "listen": "test", "script": { "exec": [
