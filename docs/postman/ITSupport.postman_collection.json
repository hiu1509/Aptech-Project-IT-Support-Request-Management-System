    {
      "name": "3. Vong doi Ticket (UC05-UC20)",
      "item": [
        {
          "name": "UC05 - Employee tao yeu cau",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "pm.test('created', () => pm.expect(json.isSuccess).to.be.true);",
            "if (json.isSuccess) pm.collectionVariables.set('request_id', json.data.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{employee_token}}" }],
            "url": "{{base_url}}/SupportRequest",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"May tinh khong vao duoc mang noi bo\",\n  \"description\": \"May tinh khong ket noi duoc mang tu sang nay.\",\n  \"priorityId\": {{priority_id}}\n}" }
          }
        },
        {
          "name": "UC22 - Employee dinh kem file (multipart)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.isSuccess) pm.collectionVariables.set('attachment_id', json.data.id);"
          ] } }],
          "request": {
            "description": "LUU Y: o tab Body, click vao o 'File' va chon 1 file that (jpg/pdf/doc/docx, <=10MB) truoc khi Send - Postman khong the tu dinh kem file khi luu collection.",
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{employee_token}}" }],
            "url": "{{base_url}}/RequestAttachment/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "RequestId", "value": "{{request_id}}", "type": "text" },
                { "key": "ContextType", "value": "REQUEST", "type": "text" },
                { "key": "File", "type": "file", "src": "" }
              ]
            }
          }
        },
